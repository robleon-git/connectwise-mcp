{
  "name": "@wyre-ai/connectwise-manage-mcp",
  "version": "1.4.0",
  "description": "ConnectWise Manage (PSA) MCP server for Claude",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "connectwise-manage-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prediagnose:cw-auth": "npm run build",
    "diagnose:cw-auth": "node scripts/diagnose-cw-auth.mjs",
    "diagnose:live-mcp": "node scripts/diagnose-live-mcp.mjs",
    "build": "tsc",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src portal/src scripts/deploy scripts/build scripts/diagnose-cw-auth.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests",
    "pretest:watch": "npm run build",
    "test:watch": "vitest --passWithNoTests",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "validate:mcpb": "mcpb validate manifest.json",
    "build:portal": "tsc -p portal/tsconfig.json && vite build --config portal/vite.config.ts",
    "start:control": "node dist/control-plane/index.js",
    "migrate": "node dist/database/cli.js",
    "test:database": "CW_DATABASE_INTEGRATION=true vitest run src/__tests__/delivery-database.integration.test.ts",
    "smoke:delivery": "node scripts/deploy/smoke.mjs",
    "release:phase0": "node scripts/deploy/release.mjs",
    "baseline:production": "node scripts/deploy/baseline.mjs",
    "validate:ticket-card": "node --experimental-vm-modules --no-warnings scripts/build/validate-ticket-card.mjs",
    "bootstrap:database": "node scripts/deploy/bootstrap-database.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/connectwise-manage-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "connectwise",
    "connectwise-manage",
    "psa",
    "msp"
  ],
  "author": "Wyre Technology",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/WYRE-AI/connectwise-manage-mcp/issues"
  },
  "homepage": "https://github.com/WYRE-AI/connectwise-manage-mcp#readme",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-secrets": "^4.11.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "fast-uri": "^3.1.8"
  },
  "private": true
}
