FROM node:26-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build
FROM node:26-alpine
ARG COMMIT_SHA
LABEL org.opencontainers.image.revision=$COMMIT_SHA
WORKDIR /app
ENV NODE_ENV=production CW_CONTROL_PORT=8080 CW_CUSTOMER_FEATURES_ENABLED=false
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY database ./database
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s CMD wget -q -O /dev/null http://localhost:8080/health || exit 1
CMD ["node","dist/control-plane/index.js"]
