# Phase 1: stdio works with CW_MANAGE_* below. Public HTTP intentionally refuses
# startup unless the complete Descope MCP verifier configuration below is supplied.
# Legacy MCP_OAUTH_ENABLED / MCP_BEARER_TOKEN / CONDUIT_S2S_SECRET do not enable HTTP.
# For explicit LOCAL testing only, set all three:
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_ALLOW_UNAUTHENTICATED_LOCAL=true
# Keep NODE_ENV outside production for this local exception.

# =============================================================================
# ConnectWise Manage — API Credentials
# =============================================================================

# Your ConnectWise company identifier (the short name used to log in)
CW_MANAGE_COMPANY_ID=yourcompany

# API member public/private key pair (create under Members > API Members in CWM)
CW_MANAGE_PUBLIC_KEY=
CW_MANAGE_PRIVATE_KEY=

# Client ID from the ConnectWise Developer Portal (developer.connectwise.com)
CW_MANAGE_CLIENT_ID=

# API base URL — choose the region that matches your CWM instance
# Cloud NA (default): https://api-na.myconnectwise.net
# Cloud EU:           https://api-eu.myconnectwise.net
# Cloud AU:           https://api-au.myconnectwise.net
# Self-hosted:        https://cwm.yourcompany.com
CW_MANAGE_URL=https://api-na.myconnectwise.net

# Set to "false" only for self-hosted instances with self-signed TLS certs
CW_MANAGE_REJECT_UNAUTHORIZED=true

# =============================================================================
# MCP Server
# =============================================================================

MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=127.0.0.1

# Only service-owned configuration is supported in Phase 1.
AUTH_MODE=env

# Descope MCP resource-server validation (public identifiers, no client secret).
# Copy issuer/JWKS from the resource-specific public discovery document.
DESCOPE_MCP_ISSUER=
DESCOPE_MCP_JWKS_URI=
MCP_RESOURCE_URI=https://api.monotorr.com/mcp
MCP_REQUIRED_SCOPE=connectwise.read
# Immutable approved Descope user ID; verify its signed MCP claim before use.
MCP_APPROVED_USER_ID=
# Explicit JSON Pointer, e.g. /sub ONLY if the real access token proves that mapping.
MCP_APPROVED_USER_CLAIM=

# =============================================================================
# Caddy (docker-compose.caddy.yml only)
# =============================================================================

# Public domain for TLS cert (must have a DNS A record pointing to this server)
MCP_HOSTNAME=mcp.yourdomain.com

# Email for Let's Encrypt registration
ACME_EMAIL=you@yourdomain.com

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=info
NODE_ENV=development
